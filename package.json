{
  "name": "commutai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CommutAI Transportation Management System",
  "scripts": {
    "dev": "cd apps/web && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "dev:conductor": "cd apps/conductor-web && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:conductor\"",
    "build": "cd apps/web && npm run build",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^8.2.2",
    "prettier": "^3.3.3",
    "turbo": "^2.0.0",
    "vite": "^8.3.0"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "autoprefixer": "^10.5.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.28.0",
    "postcss": "^8.5.19",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^6.26.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19"
  }
}
